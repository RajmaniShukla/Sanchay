/* ============================================================
   Sanchay — Main Qt Stylesheet
   Professional Light Theme
   ============================================================ */

/* ── Global Reset ──────────────────────────────────────────── */
* {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #0F172A;
    outline: none;
}

QMainWindow, QWidget#centralWidget {
    background-color: #F8FAFC;
}

/* ── Sidebar ───────────────────────────────────────────────── */
QWidget#sidebar {
    background-color: #1E293B;
    border-right: 1px solid #0F172A;
    min-width: 220px;
    max-width: 220px;
}

QLabel#appTitle {
    color: #F1F5F9;
    font-size: 16px;
    font-weight: bold;
    padding: 8px 16px 4px 16px;
}

QLabel#appVersion {
    color: #64748B;
    font-size: 11px;
    padding: 0px 16px 12px 16px;
}

QPushButton#navButton {
    background-color: transparent;
    color: #CBD5E1;
    border: none;
    border-radius: 6px;
    text-align: left;
    padding: 10px 16px;
    margin: 2px 8px;
    font-size: 13px;
}

QPushButton#navButton:hover {
    background-color: #334155;
    color: #F1F5F9;
}

QPushButton#navButton:checked {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#navSection {
    color: #475569;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 16px 16px 4px 16px;
}

/* ── Top Bar ───────────────────────────────────────────────── */
QWidget#topBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E2E8F0;
    min-height: 56px;
    max-height: 56px;
}

QLabel#pageTitle {
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
}

QLabel#userInfo {
    color: #64748B;
    font-size: 12px;
}

/* ── Content Area ──────────────────────────────────────────── */
QWidget#contentArea {
    background-color: #F8FAFC;
    padding: 24px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ── Cards ─────────────────────────────────────────────────── */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 16px;
}

QFrame#statCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    padding: 20px;
    min-width: 160px;
}

QLabel#statValue {
    font-size: 28px;
    font-weight: 700;
    color: #0F172A;
}

QLabel#statLabel {
    font-size: 12px;
    color: #64748B;
    font-weight: 500;
}

/* ── Buttons ───────────────────────────────────────────────── */
QPushButton {
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 500;
    border: 1px solid transparent;
}

QPushButton#primaryButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: 1px solid #2563EB;
}

QPushButton#primaryButton:hover {
    background-color: #1D4ED8;
}

QPushButton#primaryButton:pressed {
    background-color: #1E40AF;
}

QPushButton#primaryButton:disabled {
    background-color: #93C5FD;
    border-color: #93C5FD;
}

QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
}

QPushButton#secondaryButton:hover {
    background-color: #F9FAFB;
    border-color: #9CA3AF;
}

QPushButton#dangerButton {
    background-color: #DC2626;
    color: #FFFFFF;
    border: 1px solid #DC2626;
}

QPushButton#dangerButton:hover {
    background-color: #B91C1C;
}

QPushButton#successButton {
    background-color: #16A34A;
    color: #FFFFFF;
    border: 1px solid #16A34A;
}

QPushButton#successButton:hover {
    background-color: #15803D;
}

QPushButton#iconButton {
    background-color: transparent;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
}

QPushButton#iconButton:hover {
    background-color: #F1F5F9;
}

/* ── Inputs ─────────────────────────────────────────────────── */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 8px 12px;
    color: #0F172A;
    selection-background-color: #DBEAFE;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #2563EB;
    padding: 7px 11px;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

QLineEdit[readOnly="true"] {
    background-color: #F8FAFC;
    color: #64748B;
}

/* ── ComboBox ───────────────────────────────────────────────── */
QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 7px 12px;
    min-height: 34px;
    color: #0F172A;
}

QComboBox:focus {
    border: 2px solid #2563EB;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #64748B;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 6px;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
    padding: 4px;
}

/* ── DateEdit ───────────────────────────────────────────────── */
QDateEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 7px 12px;
    min-height: 34px;
}

QDateEdit:focus {
    border: 2px solid #2563EB;
}

/* ── Table ──────────────────────────────────────────────────── */
QTableWidget, QTableView {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    selection-background-color: #EFF6FF;
    selection-color: #1E40AF;
    alternate-background-color: #F8FAFC;
}

QTableWidget::item, QTableView::item {
    padding: 10px 12px;
    border: none;
}

QHeaderView::section {
    background-color: #F8FAFC;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    border-right: 1px solid #E2E8F0;
    padding: 10px 12px;
    font-weight: 600;
    color: #374151;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

QHeaderView::section:last {
    border-right: none;
}

/* ── Tabs ───────────────────────────────────────────────────── */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    background-color: #FFFFFF;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #64748B;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
    margin-right: 4px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #2563EB;
    border-bottom: 2px solid #2563EB;
    font-weight: 600;
}

QTabBar::tab:hover:!selected {
    color: #374151;
    border-bottom: 2px solid #D1D5DB;
}

/* ── GroupBox ───────────────────────────────────────────────── */
QGroupBox {
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    margin-top: 12px;
    padding: 16px;
    background-color: #FFFFFF;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    color: #374151;
    font-weight: 600;
    font-size: 12px;
    background-color: #FFFFFF;
}

/* ── Scrollbars ─────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #F1F5F9;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 40px;
}

QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #F1F5F9;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 40px;
}

/* ── Labels ─────────────────────────────────────────────────── */
QLabel#sectionTitle {
    font-size: 16px;
    font-weight: 700;
    color: #0F172A;
    margin-bottom: 8px;
}

QLabel#formLabel {
    font-size: 12px;
    font-weight: 600;
    color: #374151;
    margin-bottom: 4px;
}

QLabel#muted {
    color: #64748B;
    font-size: 12px;
}

QLabel#errorLabel {
    color: #DC2626;
    font-size: 12px;
}

/* ── Status Badges ──────────────────────────────────────────── */
QLabel#badgeAvailable {
    background-color: #DCFCE7;
    color: #15803D;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#badgeIssued {
    background-color: #DBEAFE;
    color: #1D4ED8;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#badgeMaintenance {
    background-color: #FEF3C7;
    color: #B45309;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QLabel#badgeOverdue {
    background-color: #FEE2E2;
    color: #B91C1C;
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

/* ── Dialog ─────────────────────────────────────────────────── */
QDialog {
    background-color: #FFFFFF;
}

QDialog QLabel#dialogTitle {
    font-size: 18px;
    font-weight: 700;
    color: #0F172A;
}

/* ── Splitter ───────────────────────────────────────────────── */
QSplitter::handle {
    background-color: #E2E8F0;
    width: 1px;
}

/* ── MessageBox ─────────────────────────────────────────────── */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
}

/* ── Tooltip ─────────────────────────────────────────────────── */
QToolTip {
    background-color: #1E293B;
    color: #F1F5F9;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ── Search Bar ─────────────────────────────────────────────── */
QLineEdit#searchBar {
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: 8px 16px 8px 36px;
    font-size: 13px;
    min-width: 240px;
}

QLineEdit#searchBar:focus {
    background-color: #FFFFFF;
    border: 2px solid #2563EB;
    padding: 7px 15px 7px 35px;
}

/* ── Progress Bar ───────────────────────────────────────────── */
QProgressBar {
    background-color: #E2E8F0;
    border-radius: 4px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #2563EB;
    border-radius: 4px;
}

/* ── CheckBox ───────────────────────────────────────────────── */
QCheckBox {
    spacing: 8px;
    color: #374151;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 2px solid #D1D5DB;
    border-radius: 4px;
    background-color: #FFFFFF;
}

QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}

/* ── Login Screen ───────────────────────────────────────────── */
QWidget#loginContainer {
    background-color: #FFFFFF;
    border-radius: 12px;
    border: 1px solid #E2E8F0;
    padding: 40px;
    min-width: 380px;
    max-width: 420px;
}

QLabel#loginTitle {
    font-size: 24px;
    font-weight: 700;
    color: #0F172A;
}

QLabel#loginSubtitle {
    font-size: 14px;
    color: #64748B;
}
